# Copy to e2e/.env and fill in credentials for the E2E test accounts.
# These must be real accounts that already exist in the database.

E2E_API_URL=http://localhost:3000
E2E_APP_URL=http://localhost:8080

# A user with the "broadcaster" role only
E2E_BROADCASTER_EMAIL=broadcaster@example.com
E2E_BROADCASTER_PASSWORD=

# A user with the "advertiser" role only
E2E_ADVERTISER_EMAIL=advertiser@example.com
E2E_ADVERTISER_PASSWORD=

# A user with both roles (optional — skipped if empty)
E2E_DUAL_EMAIL=dual@example.com
E2E_DUAL_PASSWORD=
